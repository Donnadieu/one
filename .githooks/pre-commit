#!/bin/bash
# Fast guard before every commit: identity, formatting, One's own rules and their canaries, both
# baselines, and ruff/shellcheck. The full gate is `make check` (which adds doc drift, the knowledge
# base and tools/hooks-check.sh). tools/hooks-check.sh --ci holds this list, `make check` and
# .github/workflows/rules.yml to the REQUIRED table it carries, and fails if any of the three drops a
# gate it should run or runs one nothing declared.
#
# This lints the working tree, not the staged index, so a half-staged file is judged as it is on
# disk. Being exact would mean a `git stash -k` or a throwaway worktree on every commit; the check
# that matters runs again in CI on what was actually pushed.
set -e
cd "$(git rev-parse --show-toplevel)" || exit 1
# The baseline ratchet compares against origin/main. Without this, a clone that hasn't fetched
# compares against a stale (or absent) ref, and check-baseline.sh can't tell that it didn't run.
git fetch -q origin main 2>/dev/null || true
tools/check-identity.sh
if git diff --cached --name-only | grep -q '^Sources/.*\.swift$'; then
  xcrun swift-format lint -r -s -p Sources || { echo "FIX: run 'make format', then add the files again."; exit 1; }
fi
python3 tools/lint/one-lint.py
python3 tools/lint/one-lint.py --prove
python3 tools/lint/ext-lint.py
tools/lint/check-baseline.sh --all
