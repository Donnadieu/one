# The repo is public. Two jobs: keep build output out, and make a stray credential or scratch file
# hard to commit by accident. The backstop, for a file added with `git add -f` anyway, is the
# `secret-file` rule in tools/lint/one-lint.py, which fails on a tracked file whose name says
# credential. A rule and an ignore, because either one alone has a hole.

# Build output and caches
build/
__pycache__/
*.pyc
.venv/
venv/
*.dSYM/
.DS_Store

# Credentials, keys and tokens: never in this tree, ever
.env
.env.*
!.env.example
!.env.sample
.netrc
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.ovpn
*.asc
!*.pub.asc
*.gpg
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
credentials.json
client_secret*.json
secret.yaml
secret.yml
secrets.yaml
secrets.yml

# An agent's own config, which is where a token lands without anyone deciding to put it there.
# These were ignored only by .git/info/exclude, which is untracked: it existed in one working copy
# and in no other clone, no other workspace and no CI checkout.
.mcp.json
.claude/settings.local.json
.claude/settings.local.*
.forge/
.forge-ready

# Scratch: notes, logs, shots and reviews a check or an agent leaves behind
tmp/
.context/
*.log
one-shots/
tools/lint/*.local.json
